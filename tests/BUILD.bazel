"""Unit and integration test targets for kiln_thermal_sim."""

load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

py_test(
    name = "params_test",
    size = "small",
    srcs = ["params_test.py"],
    data = ["//:configs"],
    deps = [
        "//proto:kiln_sim_py_pb2",
        "//src:io_manager",
        "//src:params",
    ],
)

py_test(
    name = "mesh_test",
    size = "small",
    srcs = ["mesh_test.py"],
    data = ["//:configs"],
    deps = [
        "//src:io_manager",
        "//src:mesh",
        "//src:params",
    ],
)

